{
  "version": 6,
  "configurePresets": [
    {
      "name": "core",
      "displayName": "Core domain tests (no Qt required)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/core",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "OPENCADDIE_BUILD_UI": "OFF",
        "OPENCADDIE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "desktop",
      "displayName": "Desktop simulator",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/desktop",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "OPENCADDIE_BUILD_UI": "ON",
        "OPENCADDIE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Raspberry Pi release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "OPENCADDIE_BUILD_UI": "ON",
        "OPENCADDIE_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "core", "configurePreset": "core" },
    { "name": "desktop", "configurePreset": "desktop" },
    { "name": "release", "configurePreset": "release" }
  ],
  "testPresets": [
    {
      "name": "core",
      "configurePreset": "core",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "desktop",
      "configurePreset": "desktop",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true }
    }
  ],
  "packagePresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "generators": ["TGZ"]
    }
  ]
}
